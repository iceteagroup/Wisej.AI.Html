<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<Deterministic>true</Deterministic>
		<RootNamespace>Wisej.AI.Html</RootNamespace>
		<AssemblyName>Wisej.AI.Html</AssemblyName>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<!-- Every public member must be documented: missing XML comments fail the build. -->
		<WarningsAsErrors>$(WarningsAsErrors);CS1591;CS1573;CS1572;CS1574</WarningsAsErrors>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<SignAssembly>True</SignAssembly>
		<AssemblyOriginatorKeyFile>extension.snk</AssemblyOriginatorKeyFile>
	</PropertyGroup>

</Project>
