<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>$(NetFxVersion)</TargetFrameworks>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<ProduceReferenceAssembly>false</ProduceReferenceAssembly>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<RunPostBuildEvent>Always</RunPostBuildEvent>
		<PackageId>Wisej-4-AI-Html</PackageId>
		<Product>Wisej-AI</Product>
		<Version>$(FileVersion)</Version>
		<Description>Standards compliant HTML parser and HTML to Markdown/text extraction for LLM context: headings, formatting, lists, tables with merged cells, images, links, code, math, forms and metadata. No dependencies.</Description>
		<PackageLicenseFile>EULA-3.2.txt</PackageLicenseFile>
		<PackageOutputPath>..\..\artifacts</PackageOutputPath>
		<SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
		<!-- the library has no dependencies. -->
		<NoWarn>NU5128</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<!-- build order only: the library is packed from its output folders below. -->
		<ProjectReference Include="..\Wisej.AI.Html\Wisej.AI.Html.csproj" ReferenceOutputAssembly="false" SetTargetFramework="TargetFramework=netstandard2.0" />
		<ProjectReference Include="..\Wisej.AI.Html\Wisej.AI.Html.csproj" ReferenceOutputAssembly="false" SetTargetFramework="TargetFramework=$(NetCoreVersion)" />
	</ItemGroup>

	<ItemGroup>
		<!-- EULA -->
		<None Include="EULA-3.2.txt" Pack="true" PackagePath="" />

		<!-- Wisej.AI.Html -->
		<None Include="$(ProjectDir)..\Wisej.AI.Html\bin\$(Configuration)\netstandard2.0\Wisej.AI.Html.dll" Pack="true" PackagePath="lib\netstandard2.0" />
		<None Include="$(ProjectDir)..\Wisej.AI.Html\bin\$(Configuration)\$(NetCoreVersion)\Wisej.AI.Html.dll" Pack="true" PackagePath="lib\$(NetCoreVersion)" />

		<!-- Wisej.AI.Html Documentation -->
		<None Include="$(ProjectDir)..\Wisej.AI.Html\bin\$(Configuration)\netstandard2.0\Wisej.AI.Html.xml" Pack="true" PackagePath="lib\netstandard2.0" />
		<None Include="$(ProjectDir)..\Wisej.AI.Html\bin\$(Configuration)\$(NetCoreVersion)\Wisej.AI.Html.xml" Pack="true" PackagePath="lib\$(NetCoreVersion)" />

	</ItemGroup>

	<Target Name="CopyWisejArtifacts" AfterTargets="Build">
		<Copy SourceFiles="$(ProjectDir)..\Wisej.AI.Html\bin\$(Configuration)\netstandard2.0\Wisej.AI.Html.dll"
			  DestinationFolder="$(ProjectDir)..\..\artifacts\bin\netstandard2.0\"
			  SkipUnchangedFiles="true"
			  OverwriteReadOnlyFiles="true" />

		<Copy SourceFiles="$(ProjectDir)..\Wisej.AI.Html\bin\$(Configuration)\$(NetCoreVersion)\Wisej.AI.Html.dll"
			  DestinationFolder="$(ProjectDir)..\..\artifacts\bin\$(NetCoreVersion)\"
			  SkipUnchangedFiles="true"
			  OverwriteReadOnlyFiles="true" />
	</Target>

</Project>
